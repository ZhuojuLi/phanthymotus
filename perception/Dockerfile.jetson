# JetPack 6 obstacle-only image. Its base-image layout follows the proven OCR
# Dockerfile: ROS Humble comes from the JP6 ROS image and CUDA torch/torchvision
# are copied from the matching L4T PyTorch donor. Build from the repository root:
#   docker build -f perception/Dockerfile.jetson --network=host \
#     -t phanthymotus-perception-obstacle:jp6 .

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG ROS_BASE=docker.m.daocloud.io/dustynv/ros:humble-desktop-l4t-r36.4.0
ARG PYTORCH_DONOR=docker.m.daocloud.io/dustynv/l4t-pytorch:r36.4.0
ARG BASE_IMAGE=

# Match the OCR branch's JP6 base construction. Local Jetson builds normally
# pass BASE_IMAGE=local/phanthy-motus/jetson-base:jp6-torch and reuse the image
# prepared by deploy/prepare_jp_v6_local.sh.
FROM ${PYTORCH_DONOR} AS pytorch-donor
FROM ${ROS_BASE} AS jp6-torch-built
# The ROS JP6 base already provides OpenBLAS. Avoid touching its expired ROS APT
# metadata here; in particular, do not copy OCR's --allow-unauthenticated workaround.
COPY --from=pytorch-donor /usr/local/lib/python3.10/dist-packages/ /tmp/pt-donor/
RUN cd /tmp/pt-donor && \
    mkdir -p /usr/local/lib/python3.10/dist-packages && \
    for item in torch torchgen torchvision triton; do \
      if [ -e "$item" ]; then cp -a "$item" /usr/local/lib/python3.10/dist-packages/; fi; \
    done && \
    shopt -s nullglob && \
    for item in torch-*.dist-info torchvision-*.dist-info triton-*.dist-info; do \
      cp -a "$item" /usr/local/lib/python3.10/dist-packages/; \
    done && \
    rm -rf /tmp/pt-donor

FROM ${BASE_IMAGE:-jp6-torch-built}
ARG PYPI_MIRROR
ARG APT_MIRROR

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org" \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    MALLOC_ARENA_MAX=2 \
    FASTDDS_BUILTIN_TRANSPORTS=UDPv4 \
    YOLO_CONFIG_DIR=/tmp

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" \
        /etc/apt/sources.list; \
    fi

# Keep the CUDA-enabled torch/torchvision shipped by the OCR-compatible JP6 base.
# The mixed TensorRT backend needs the YOLO26 depth predictor introduced after
# 8.4.102. Pin the Jetson-tested runtime without allowing pip to replace CUDA
# torch.
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
      "numpy==1.26.4" \
      "onnxruntime==1.23.2" \
      pyyaml requests scipy matplotlib pandas tqdm Pillow psutil py-cpuinfo \
      seaborn polars "ultralytics-thop>=2.0.0" && \
    pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} \
      "ultralytics==8.4.115"

# Models are external artifacts. The downloader installs them atomically only
# after exact byte-size and SHA256 verification.
COPY perception/models/obstacle-artifacts.json /tmp/obstacle-artifacts.json
COPY perception/utils/obstacle_model_downloader.py /tmp/obstacle_model_downloader.py
RUN python3 /tmp/obstacle_model_downloader.py \
      --manifest /tmp/obstacle-artifacts.json \
      --timeout 120 \
      --retries 3

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
# The platform launches the service with the FastDDS profile at this path
# (same layout as the judge evaluation image). Ship it so rclpy/FastDDS does
# not fall back to an unparsed XML on every node start.
COPY perception/config/fastdds_large_message.xml /opt/phanthy-motus/config/fastdds_large_message.xml

RUN python3 -m py_compile \
      /work/main.py \
      /work/plugins/obstacle.py \
      /work/plugins/obstacle_distance_core/*.py \
      /work/utils/obstacle_model_downloader.py && \
    cd /work && python3 -c "from plugins.obstacle_distance_core.zipdepth_tensorrt_backends import create_backends; import os; paths=['/models/obstacle-distance/zipdepth-int8/zipdepth-base-npu-512x384-int8.engine', '/models/obstacle-distance/zipdepth-int8/yolo26n-depth-int8.engine', '/models/obstacle-distance/zipdepth-int8/yolo26n-seg-int8.engine', '/models/obstacle-distance/zipdepth-int8/resnet18_places365-static-qoperator-int8.onnx', '/models/obstacle-distance/zipdepth-int8/IO_places365.txt']; assert all(os.path.isfile(path) for path in paths)"

EXPOSE 15720

CMD ["/bin/bash", "-c", \
    "if [ -f /opt/ros/humble/setup.bash ]; then \
       source /opt/ros/humble/setup.bash; \
     else \
       source /opt/ros/humble/install/setup.bash; \
     fi && \
     python3 /work/main.py"]
